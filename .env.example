# Copy this file to .env and fill in your key.

# NVIDIA NIM key (free): https://build.nvidia.com  ->  Get API Key  (starts with nvapi-)
NVIDIA_API_KEY=

# Any OpenAI-compatible endpoint also works (OpenRouter, Groq, Ollama, ...)
UPSTREAM_BASE_URL=https://integrate.api.nvidia.com/v1

DEFAULT_MODEL=minimaxai/minimax-m3.1-flash

# Optional server-wide persona override
# SYSTEM_PROMPT=You are Nova, a helpful and witty AI assistant.

PORT=4173

# ---------------- Free media providers ----------------
# Images: bing (UI automation, best free quality), cloudflare (Flux),
# pollinations (fallback). Browser settings can override these.
DEFAULT_IMAGE_PROVIDER=bing
DEFAULT_VIDEO_PROVIDER=ltx

# Cloudflare Workers AI: free 10,000 neurons/day. Account ID + API token.
# https://dash.cloudflare.com/?to=/:account/ai/workers-ai
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hugging Face token optional for LTX-Video (anonymous free queue also works).
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Pollinations key is optional for images, needed only for its video provider.
# https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=

# Chrome/Edge CDP used by Bing Image Creator and browser automation tools.
CDP_PORT=9222
